# Data that shouldn't be public
# Keep the code & structure, hide large raw downloads
data-*/vendor_details/      # Raw API responses with possibly sensitive menu data
data-*/vendor_reviews/      # Raw review JSON files (keep CSVs instead)

# But DO NOT ignore these (they're useful & anonymized):
# - data-*/all_vendors.json (public data)
# - data-*/restaurants.csv (processed public data)
# - data-*/vendor_reviews_summary.csv (aggregated reviews)
# - data-*/vendor_menus.csv (menu data)
# - data-*/by_area/, by_city/, by_chain/ (organized data)
# - data-*/summary.json (statistics)

# mitmproxy config (contains session data)
.mitmproxy/
.mitmproxy/mitmproxy-ca-cert.pem
.mitmproxy/mitmproxy-ca-key.pem
