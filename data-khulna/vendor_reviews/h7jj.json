    {
      "uuid": "1af02253-ae01-4a5e-b595-2922490a903e",
      "createdAt": "2026-05-15T16:22:54Z",
      "updatedAt": "2026-05-15T16:22:54Z",
      "text": "এত খারাপ খাবার আগে কখনো খাইনি। মনে হচ্ছে বাসি খাবার গরম করে দিয়েছে—একদমই কোনো স্বাদ নেই। ৪ টুকরো মাংস মিলিয়ে ওজন সর্বোচ্চ ৬০ গ্রাম হবে।এতো কম পরিমাণ খাবারের দাম ২২০ টাকা হওয়া কখনোই সম্ভব না।",
      "isAnonymous": false,
      "reviewerName": "Md",
      "reviewerId": "bdoo2hbl",
      "ratings": [
        {
          "topic": "overall",
          "score": 1
        },
        {
          "topic": "restaurant_food",
          "score": 1
        },
        {
          "topic": "rider",
          "score": 5
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "1af02253-ae01-4a5e-b595-2922490a903e",
          "text": "ধন্যবাদ, আমাদের গরুর মাংস সবাই অনেক পছন্দ করে আমি সব ১পিছ বেশি দেই কখনও কম দেই না আর বাসি খাবার কখনও সেল করিনা।",
