    {
      "uuid": "b8516634-7da5-4e6b-9666-ff7cdd1ead74",
      "createdAt": "2026-03-31T14:51:51Z",
      "updatedAt": "2026-03-31T14:51:51Z",
      "text": "আলহামদুলিল্লাহ, খাবারের পরিমান যথেষ্ঠ ছিল। খিচুরি ও গরুর মাংস ভালোই লাগলো তবে গরুর মাংসটা বেশি মজা লাগছে। ইনশাআল্লাহ পরবর্তীতেও আপনাদের থেকেই অর্ডার করবো। এভাবেই সবসময় ভালো খাবার দিবেন যেন অন্য কোথাও ",
      "isAnonymous": false,
      "reviewerName": "Nusrat",
      "reviewerId": "bdu8naod",
      "ratings": [
        {
          "topic": "overall",
          "score": 5
        },
        {
          "topic": "restaurant_food",
          "score": 5
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "b8516634-7da5-4e6b-9666-ff7cdd1ead74",
          "text": "ধন্যবাদ আপনার সুন্দর ফিডব্যাকের জন্য।\nসবসময় চেষ্টা করি পর্যাপ্ত পরিমাণ ও ভালো মানের খাবার দিতে।\nইনশাআল্লাহ ভবিষ্যতেও একইভাবে ভালো সার্ভিস দেওয়ার চেষ্টা করবো।",
