    {
      "uuid": "27e5ff9a-bc1b-4ffe-816e-f69cb7a9a652",
      "createdAt": "2026-04-23T09:55:53Z",
      "updatedAt": "2026-04-23T09:55:53Z",
      "text": "আপুর হাতের রান্নাগুলো চমৎকার। আর প্রতিবারই আপু কিছু না কিছু কমপ্লিমেন্টারি দিয়ে দেন। আজকের আম ডাল টা কমপ্লিমেন্টারি হিসেবে ছিলো এবং খেতেও চমৎকার ছিলো। সাথে ভর্তাগুলোও অনেক মজার ছিলো।",
      "isAnonymous": false,
      "reviewerName": "MI",
      "reviewerId": "bdb1h0pm",
      "ratings": [
        {
          "topic": "overall",
          "score": 5
        },
        {
          "topic": "restaurant_food",
          "score": 5
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "27e5ff9a-bc1b-4ffe-816e-f69cb7a9a652",
          "text": "আপনার ভালো লেগেছে জেনে সত্যিই অনেক আনন্দ লাগছে। চেষ্টা করি প্রতিবারই একটু ভিন্ন কিছু দিয়ে আপনাদের খুশি করতে।এটাই আমাদের সবচেয়ে বড় প্রাপ্তি ।\nআগামীতেও আপনার জন্য ভালো কিছু নিয়ে আসার চেষ্টা থাকবে। আবার অর্ডার করবেন আশা করি ।",
          "createdAt": "2026-04-27T08:57:21Z",
          "updatedAt": "2026-04-27T08:57:21Z",
          "commentPrettyDate": {
            "translationKey": "NEXTGEN_REVIEWS_X_WEEKS_AGO",
