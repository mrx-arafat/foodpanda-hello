    {
      "uuid": "598ee5c1-7d8f-474c-9cd4-6518c65a0384",
      "createdAt": "2025-09-01T15:02:16Z",
      "updatedAt": "2025-09-01T15:02:16Z",
      "text": "মেয়াদ উত্তীর্ণ হতে কয়েক ঘণ্টা বাকি। কিভাবে এটা ডেলিভারি করলেন। বুঝলাম না।টেষ্ট একদম বাজে গন্ধ আর টক হয় গেছে। আমি ভোক্তা অধিকার এ অভিযোগ জানাবো। ধন্যবাদ।",
      "isAnonymous": false,
      "reviewerName": "rana",
      "reviewerId": "bdi8fze2",
      "ratings": [
        {
          "topic": "overall",
          "score": 1
        },
        {
          "topic": "restaurant_food",
          "score": 1
        },
        {
          "topic": "rider",
          "score": 1
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "598ee5c1-7d8f-474c-9cd4-6518c65a0384",
          "text": "**প্রিয় কাস্টমার,**\nআপনার অভিজ্ঞতার জন্য আমরা আন্তরিকভাবে দুঃখিত। এটি হওয়া উচিত নয়, এবং আমরা বিষয়টি আমাদের কিচেন ও ডেলিভারি টিমের সাথে শেয়ার করেছি যেন ভবিষ্যতে এমন ঘটনা না ঘটে। আপনার মতামতের জন্য ধন্যবাদ।\n\n— **Mithai Team**\n",
