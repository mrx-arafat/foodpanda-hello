      "type": "user",
      "replies": [
        {
          "id": "f08d56ce-7f33-46a5-8d42-9a389fcdee19",
          "text": "প্রিয় গ্রাহক, আমরা আন্তরিকভাবে দুঃখিত। আমরা আমাদের টিমকে এই বিষয়ে অবহিত করেছি  ভবিষ্যতে আমরা খাবারের মান আরও ভালো রাখার চেষ্টা করব। \nপরবর্তী সময়ে আরও সতর্ক থাকব। ",
          "createdAt": "2026-05-15T08:42:33Z",
          "updatedAt": "2026-05-15T08:42:33Z",
          "commentPrettyDate": {
            "translationKey": "NEXTGEN_REVIEWS_1_WEEK_AGO",
