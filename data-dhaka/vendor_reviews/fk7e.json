    {
      "uuid": "bd3a609d-a577-4d90-8a30-fc5326f65239",
      "createdAt": "2025-05-30T10:03:25Z",
      "updatedAt": "2025-05-30T10:03:25Z",
      "text": "ব্যাচেলর হিসেবে দুপুরে খাবারের অর্ডার দিলাম, আপনাদের খাবার একদম খাওয়া অনুপযোগী। খাবারের মান হিসেবে দাম অনেক বেশি। আর ভুয়া রেটিং কিনেছেন এটাই বুঝলাম। এমন প্রতারণামূলক ব্যবসা বাদ দেন।",
      "isAnonymous": false,
      "reviewerName": "Mushfik",
      "reviewerId": "bd8sdq3f",
      "ratings": [
        {
          "topic": "overall",
          "score": 1
        },
        {
          "topic": "restaurant_food",
          "score": 1
        },
        {
          "topic": "rider",
          "score": 1
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "bd3a609d-a577-4d90-8a30-fc5326f65239",
          "text": "প্রথমেই আপনার পর্যালোচনার জন্য ধন্যবাদ। আমরা অবশ্যই এটি খতিয়ে দেখব। আমরা ৪ বছর ধরে হালাল ব্যবসা করে আসছি আলহামদুলিল্লাহ। ইনশাআল্লাহ ভবিষ্যতেও করব। আমাদের বাজেটের মধ্যে যতটা সম্ভব দেওয়ার চেষ্টা করি।",
          "createdAt": "2025-05-30T13:53:54Z",
          "updatedAt": "2025-05-30T13:53:54Z",
          "commentPrettyDate": {
            "translationKey": "NEXTGEN_REVIEWS_X_MONTHS_AGO",
            "timeDuration": "11"
          }
        }
      ],
