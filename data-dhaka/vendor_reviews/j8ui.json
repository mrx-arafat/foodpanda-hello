    {
      "uuid": "fee197b9-81d8-4bfa-8c78-3e97d53ed22b",
      "createdAt": "2026-05-22T10:36:17Z",
      "updatedAt": "2026-05-22T10:36:17Z",
      "text": "তারা আমার থেকে যে পরিমাণ টাকা নিয়েছে সেই অনুযায়ী কোন প্রকার খাবার দেয়নি বিশেষ করে আলু ভাজিটা জঘন্য ছিল টমেটো ভর্তা আমি এরকম জীবনেও খাইনি সব থেকে বাজে খাবার এই দোকানটা কেন রেখেছে ফুটপান্ডায়",
      "isAnonymous": false,
      "reviewerName": "Jahura",
