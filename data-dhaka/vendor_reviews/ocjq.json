    {
      "uuid": "1dc7765e-acd1-4f35-887c-6a1fa037cda1",
      "createdAt": "2025-10-10T16:15:52Z",
      "updatedAt": "2025-10-10T16:15:52Z",
      "text": "চিকেন ছোট ছোট পিস সব, তেমন স্বাদও পাইনি ,ভাত দিছিলো ভিজা স্যাঁতসেঁতেগুলা, মুরগির লেগ ত নাই ই, প্রথম দিনেরটা ভালো ছিলো যদিও",
      "isAnonymous": false,
      "reviewerName": "আওয়াব",
      "reviewerId": "bd2mrij1",
      "ratings": [
        {
          "topic": "overall",
          "score": 1
        },
        {
          "topic": "restaurant_food",
          "score": 1
        }
      ],
      "type": "user",
      "replies": [
        {
          "id": "1dc7765e-acd1-4f35-887c-6a1fa037cda1",
          "text": "মুরগীর পিস ছোট হয়েছে বলেই কিন্তু আমি চিকেন পিস বাড়িয়ে দিয়েছিলাম। লেগপিস শেষ হয়ে গিয়েছিল। নেক্সট টাইম খেয়াল রাখবো ইন শা আল্লাহ। ",
          "createdAt": "2025-10-10T18:08:41Z",
          "updatedAt": "2025-10-10T18:08:41Z",
          "commentPrettyDate": {
            "translationKey": "NEXTGEN_REVIEWS_X_MONTHS_AGO",
            "timeDuration": "7"
          }
        }
